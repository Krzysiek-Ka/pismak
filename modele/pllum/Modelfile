# PLLuM 4B chat 2512 (Q4_K_M) dla Pismaka.
# Plik GGUF pobierz do tego katalogu, potem: ollama create pismak-pllum -f modele\pllum\Modelfile
# Szczegóły: README, punkt 3.1.
FROM ./pllum-4b-chat-2512-q4_k_m.gguf
# Szablon rozmowy z CYFRAGOVPL/PLLuM-4B-chat-2512 (chat_template.jinja): prompt systemowy
# poprzedza pierwszą wiadomość użytkownika w [INST]…[/INST], odpowiedź kończy <eos>.
# Plik GGUF nie zawiera szablonu, a {{ .Prompt }} nie dawał modelowi tego formatu rozmowy.
TEMPLATE """{{- $system := "" }}
{{- range .Messages }}
{{- if eq .Role "system" }}{{ $system = .Content }}
{{- else if eq .Role "user" }}[INST]{{ if $system }}{{ $system }}

{{ end }}{{ .Content }}[/INST]{{ $system = "" }}
{{- else if eq .Role "assistant" }}{{ .Content }}<eos>
{{- end }}
{{- end }}"""
PARAMETER stop "[INST]"
# Okno 32 768 tokenów zamiast pełnych 131 072: pełne okno zajmowało ok. 6 GB i na komputerze
# z 16 GB RAM model padał z braku pamięci (złote zbiory i E2E, 2026-10-24). Najdłuższy prompt
# Pismaka (reranker) ma ok. 14 tys. tokenów. Po zmianie ponownie wykonaj `ollama create`.
PARAMETER num_ctx 32768
# Kara za powtórzenia. Pismak wysyła żądania przez endpoint zgodny z OpenAI, który jej nie
# ustawia (w logu Ollamy: repeat_penalty = 1.000), a bez niej model potrafi powtarzać ten sam
# fragment aż do limitu odpowiedzi. Wartość łagodna, bo w JSON-ie kara dotyczy też znaków
# struktury (cudzysłowy, przecinki).
PARAMETER repeat_penalty 1.1
