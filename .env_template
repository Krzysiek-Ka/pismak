# ==========================================
# APPLICATION
# ==========================================

APP_ENV=development
APP_NAME=pismak
LOG_LEVEL=INFO


# ==========================================
# LOCAL MODELS
# ==========================================
# PLLuM 4B
PLLLUM_MODEL_PATH= .../modele/pllum/pllum-4b-chat-2512-q4_k_m.gguf

# Bielik
BIELIK_MODEL_PATH=.../modele/bielik/bielik.gguf


# ==========================================
# LLM SERVER
# ==========================================
PLLLUM_API_URL=http://localhost:8000/v1
BIELIK_API_URL=http://localhost:8001/v1




# ==========================================
# RAG
# ==========================================
# Local development defaults; change the database password before exposing any service.
POSTGRES_USER=pismak
POSTGRES_PASSWORD=pismak_dev
POSTGRES_DB=pismak

DATABASE_URL=postgresql://pismak:pismak_dev@localhost:5432/pismak


# Ollama
OLLAMA_URL=http://127.0.0.1:11434

# BGE-M3 w Ollama zwraca 1024-wymiarowe embeddingi
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIM=1024
RAG_LLM_MODEL=pllum


# ==========================================
OPENROUTER_KEY=sk-or-v1-WSTAW_TUTAJ_SWÓJ_KLUCZ