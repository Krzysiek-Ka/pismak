# Konfiguracja lokalna Pismaka. Skopiuj do `.env` (README, punkt 4.1) przed pierwszym
# uruchomieniem bazy. Hasła poniżej są publiczne: zmień je, zanim udostępnisz aplikację.

# ==========================================
# BAZA RAG (PostgreSQL + pgvector)
# ==========================================
# Superuser tworzony przy pierwszym starcie kontenera; tylko do administracji bazą.
POSTGRES_USER=pismak
POSTGRES_PASSWORD=pismak_dev
POSTGRES_DB=pismak

# Hasła ról tworzonych przez docker/postgres/init/002_roles.sql (README, punkt 4.2):
# pismak_ingest wczytuje dokumenty, pismak_app ma wyłącznie prawo odczytu.
PISMAK_INGEST_DB_PASSWORD=pismak_ingest_dev
PISMAK_APP_DB_PASSWORD=pismak_app_dev

# Adres IPv4 zamiast `localhost`: port bazy jest publikowany tylko na 127.0.0.1,
# a `localhost` wskazuje najpierw na IPv6 (::1) i każde połączenie czeka wtedy ponad 2 minuty.
# Interfejs, wyszukiwanie i testy RAG: rola tylko do odczytu.
DATABASE_URL=postgresql://pismak_app:pismak_app_dev@127.0.0.1:5432/pismak
# Ingestion dokumentów (polecenie z README 5.1 i notebooki ingestion).
RAG_INGESTION_DATABASE_URL=postgresql://pismak_ingest:pismak_ingest_dev@127.0.0.1:5432/pismak


# ==========================================
# OLLAMA
# ==========================================
OLLAMA_URL=http://127.0.0.1:11434

# Okno kontekstu Pismak ustala sam dla każdego wybranego modelu (README, punkt 3.3).
# Opcjonalnie: górny limit okna w tokenach, gdy mniejsze prompty mają przyspieszyć pracę.
# PISMAK_CONTEXT_TOKENS=8192
# PISMAK_OPENROUTER_CONTEXT_TOKENS=32768

# BGE-M3 w Ollama zwraca 1024-wymiarowe embeddingi
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIM=1024


# ==========================================
# OPENROUTER (opcjonalnie, README rozdział 6)
# ==========================================
OPENROUTER_KEY=sk-or-v1-WSTAW_TUTAJ_SWÓJ_KLUCZ
