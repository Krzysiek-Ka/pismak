# ==========================================
# DATABASE / LOCAL DATA
# ==========================================

data/
# Zbiór pytań ewaluacji RAG należy do testów; CI wczytuje go przy zbieraniu testów.
!tests/golden_set/rag_eval/data/
*.db
*.sqlite
*.sqlite3

postgres-data/

# Wyniki złotych zbiorów i testów E2E (raporty z przebiegów na modelach).
tests/golden_set/*/results/
tests/e2e/results/

# Generated UI runs are local data; keep concrete examples for documentation.
outputs/*
!outputs/20260926_200658_ui/
!outputs/20260926_200658_ui/**
# Przykładowa sprawa przez wszystkie etapy, z korektą językową (Pismopoprawiator).
!outputs/SAMPLE/
!outputs/SAMPLE/**


